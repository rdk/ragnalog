{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "version.v1.schema.json",
  "title": "version.v1",
  "description": "Tool, schema and signature versions: `version`, `GET /api/version`.",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "version.v1"
      ]
    },
    "version": {
      "description": "ragnalog version.",
      "type": "string"
    },
    "schema_version": {
      "description": "Store schema version <major>.<minor>.",
      "type": "string"
    },
    "signature_version": {
      "description": "Signature algorithm version.",
      "type": "integer"
    },
    "mask_rules_version": {
      "description": "Built-in masking rules version.",
      "type": "integer"
    },
    "python": {
      "description": "Python version.",
      "type": "string"
    },
    "build": {
      "description": "The build: number, git hash and build time.",
      "$ref": "#/$defs/VersionBuild"
    }
  },
  "required": [
    "schema",
    "version",
    "schema_version",
    "signature_version",
    "mask_rules_version",
    "python",
    "build"
  ],
  "$defs": {
    "VersionBuild": {
      "title": "VersionBuild",
      "description": "The build of the running ragnalog.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Build number: the commit count of the built commit (null: unknown).",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "git": {
          "description": "The built commit's hash, 7 characters (null: unknown).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "description": "When the container image was built, ISO 8601 UTC (null: not an image).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "image: recorded when the image was built; checkout: a git checkout's HEAD; unknown.",
          "enum": [
            "checkout",
            "image",
            "unknown"
          ]
        }
      },
      "required": [
        "number",
        "git",
        "time",
        "source"
      ]
    }
  }
}
