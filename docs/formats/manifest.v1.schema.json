{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.v1.schema.json",
  "title": "manifest.v1",
  "description": "How an agent uses ragnalog: `manifest`, bare `ragnalog` piped, `GET /api/manifest`.",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "manifest.v1"
      ]
    },
    "tool": {
      "description": "Command name.",
      "type": "string"
    },
    "version": {
      "description": "Tool version.",
      "type": "string"
    },
    "usage": {
      "description": "Command line shape.",
      "type": "string"
    },
    "notes": {
      "description": "Conventions every command follows.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow": {
      "description": "The usual order of commands.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestStep"
      }
    },
    "when": {
      "description": "Commands for other situations.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestStep"
      }
    },
    "commands": {
      "description": "Every command by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ManifestCommand"
      }
    },
    "help": {
      "description": "One-line help by parameter name, as most commands give it (ragnalog COMMAND --help has each command's own): names several commands share and the parameters of the workflow and when commands.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "global_options": {
      "description": "\"TYPE[=DEFAULT]: help\" of each option.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "exit_codes": {
      "description": "Meaning of each exit code.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "documents": {
      "description": "The output documents and their schemas.",
      "$ref": "#/$defs/ManifestDocuments"
    },
    "presets": {
      "description": "Columns of the --brief presets.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "env": {
      "description": "Environment variables.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "tool",
    "version",
    "usage",
    "notes",
    "workflow",
    "when",
    "commands",
    "help",
    "global_options",
    "exit_codes",
    "documents",
    "presets",
    "env"
  ],
  "$defs": {
    "ManifestCommand": {
      "title": "ManifestCommand",
      "description": "One command.",
      "type": "object",
      "properties": {
        "summary": {
          "description": "First line of --help; omitted for workflow/when steps.",
          "type": "string",
          "default": ""
        },
        "usage": {
          "description": "Arguments (UPPERCASE, ... = several) and [--option TYPE[=DEFAULT]]: TYPE str, int, float, path or choices a|b|c, * = repeatable; [--flag] takes no value.",
          "type": "string",
          "default": ""
        },
        "output": {
          "description": "Document printed (ragnalog schema NAME).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit": {
          "description": "Possible exit codes (see exit_codes).",
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        }
      },
      "required": []
    },
    "ManifestDocuments": {
      "title": "ManifestDocuments",
      "description": "Where the document schemas are.",
      "type": "object",
      "properties": {
        "get": {
          "description": "How to get a schema.",
          "type": "string"
        },
        "names": {
          "description": "Document names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "get",
        "names"
      ]
    },
    "ManifestStep": {
      "title": "ManifestStep",
      "description": "One step of the workflow, or one situation of `when`.",
      "type": "object",
      "properties": {
        "run": {
          "description": "Command line, e.g. triage SET.",
          "type": "string"
        },
        "purpose": {
          "description": "What it is for.",
          "type": "string"
        }
      },
      "required": [
        "run",
        "purpose"
      ]
    }
  }
}
