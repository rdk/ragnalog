{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query.v1.schema.json",
  "title": "query.v1",
  "description": "Rows of a DuckDB query: `query`.",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "query.v1"
      ]
    },
    "logset": {
      "description": "Set id; capture:<id> for a query over all nodes of a capture.",
      "type": "string"
    },
    "columns": {
      "description": "Result columns, in order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "count": {
      "description": "Rows in items.",
      "type": "integer"
    },
    "total": {
      "description": "Equals count.",
      "type": "integer"
    },
    "truncated": {
      "description": "True when the API cut the result at its row cap (more rows follow); CLI: never.",
      "type": "boolean"
    },
    "items": {
      "description": "One object per result row.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baseline": {
      "description": "With --baseline: its set id (capture:<id> for a capture), whose views are baseline_entries, baseline_groups (and baseline_merges).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema",
    "logset",
    "columns",
    "count",
    "total",
    "truncated",
    "items"
  ]
}
