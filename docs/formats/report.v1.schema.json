{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.v1.schema.json",
  "title": "report.v1",
  "description": "The HTML report's payload (envelope; docs/formats/report.v1.md has the parts).",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "report.v1"
      ]
    },
    "generated_at": {
      "description": "Build time, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string"
    },
    "tool_version": {
      "description": "Version that built the payload.",
      "type": "string"
    },
    "options": {
      "description": "Build options.",
      "$ref": "#/$defs/ReportOptions"
    },
    "logset": {
      "description": "The set's manifest.",
      "$ref": "#/$defs/logset.v1"
    },
    "stats": {
      "description": "stats.v1 body without sources.",
      "type": "object"
    },
    "timeline": {
      "description": "{hours, levels}.",
      "type": "object"
    },
    "groups": {
      "description": "Compact group rows.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entries": {
      "description": "Example entries by id.",
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "merges": {
      "description": "Drain3 proposals within the groups.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "compare": {
      "description": "Comparison with --compare; null without.",
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries_url": {
      "description": "Web app: examples URL template.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "generated_at",
    "tool_version",
    "options",
    "logset",
    "stats",
    "timeline",
    "groups",
    "entries",
    "merges",
    "compare"
  ],
  "$defs": {
    "IngestInfo": {
      "title": "IngestInfo",
      "description": "What one ingest did (`atlas-log ingest`, `job.v1` `result`).",
      "type": "object",
      "properties": {
        "parsed_entries": {
          "description": "Entries parsed from the files.",
          "type": "integer"
        },
        "parse_errors": {
          "description": "Entries whose header was not recognised.",
          "type": "integer"
        },
        "elapsed_s": {
          "description": "Seconds the ingest took.",
          "type": "number"
        },
        "existing": {
          "description": "The set existed already and was reused.",
          "type": "boolean"
        },
        "skipped": {
          "description": "Files found in a directory that are not in the format.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "description": "E.g. that --name was ignored for an existing set.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "parsed_entries",
        "parse_errors",
        "elapsed_s",
        "existing",
        "skipped",
        "warnings"
      ]
    },
    "MergeRow": {
      "title": "merges.v1 row",
      "description": "One Drain3 merge proposal (atlas-log schema merges).",
      "type": "object",
      "properties": {
        "cluster_id": {
          "description": "Drain3 cluster id.",
          "type": "integer"
        },
        "drain_template": {
          "description": "Template proposed by Drain3 (<*> wildcards).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "signatures": {
          "description": "Signatures proposed to be merged.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReportOptions": {
      "title": "ReportOptions",
      "description": "Build options of a report payload.",
      "type": "object",
      "properties": {
        "min_level": {
          "description": "Level filter or null.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "examples": {
          "description": "Example entries per group.",
          "type": "integer"
        },
        "max_raw": {
          "description": "Characters of raw kept; 0 = all.",
          "type": "integer"
        },
        "max_groups": {
          "description": "Largest groups kept; null = all.",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated_groups": {
          "description": "Groups cut by max_groups.",
          "type": "integer"
        }
      },
      "required": [
        "min_level",
        "examples",
        "max_raw",
        "max_groups",
        "truncated_groups"
      ]
    },
    "SetSummary": {
      "title": "SetSummary",
      "description": "Entry counts by severity of a set, from its groups table.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "Entries at ERROR or FATAL.",
          "type": "integer"
        },
        "warnings": {
          "description": "Entries at WARN.",
          "type": "integer"
        },
        "error_groups": {
          "description": "Groups at ERROR or FATAL.",
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "error_groups"
      ]
    },
    "Source": {
      "title": "Source",
      "description": "One ingested file of a log set.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the file as given at ingest.",
          "type": "string"
        },
        "size": {
          "description": "Size in bytes.",
          "type": "integer"
        },
        "xxh3": {
          "description": "xxh3-64 hex digest of the content.",
          "type": "string"
        },
        "first_ts": {
          "description": "ISO 8601 time of the file's earliest entry.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_ts": {
          "description": "ISO 8601 time of the file's latest entry.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "description": "Entries of the file kept after deduplication.",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "xxh3",
        "first_ts",
        "last_ts",
        "entries"
      ]
    },
    "logset.v1": {
      "title": "logset.v1",
      "description": "A log set's manifest: `ingest`, `set`, `regroup`, `GET /api/sets/{ref}`.",
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "logset.v1"
          ]
        },
        "id": {
          "description": "xxh3-64 hex of the LF-joined sorted source xxh3 digests.",
          "type": "string"
        },
        "name": {
          "description": "Human alias given at ingest.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "description": "Format registry key, e.g. jira.",
          "type": "string"
        },
        "sources": {
          "description": "Ingested files in ingest order; timestamps ISO 8601 or null; entries = rows kept after deduplication.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "first_ts": {
          "description": "ISO 8601 timestamp (UTC) of the earliest entry.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_ts": {
          "description": "ISO 8601 timestamp (UTC) of the latest entry.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_count": {
          "description": "Rows in entries.parquet.",
          "type": "integer"
        },
        "group_count": {
          "description": "Rows in groups.parquet.",
          "type": "integer"
        },
        "created_at": {
          "description": "ISO 8601 time (UTC) the set was written.",
          "type": "string"
        },
        "tool_version": {
          "description": "atlas-log-analyzer version that wrote the set.",
          "type": "string"
        },
        "schema_version": {
          "description": "Store schema version <major>.<minor>.",
          "type": "string"
        },
        "signature_version": {
          "description": "Signature algorithm version.",
          "type": "integer"
        },
        "mask_rules_version": {
          "description": "Built-in masking rules version.",
          "type": "integer"
        },
        "signature_spec": {
          "description": "SignatureSpec.key used for the primary signature.",
          "type": "string"
        },
        "recipe_key": {
          "description": "Recipe the set was signed with: format@version, signature spec, sig<N>, mask<N> and rules:<xxh3> of extra masking rules (if any), joined by vertical bars. Sets are comparable when it is equal; derived from the fields above for older manifests. Missing only from older tool versions.",
          "type": "string"
        },
        "node": {
          "description": "Cluster node id the logs come from (NODE1); null when unknown. Missing only from older tool versions.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cluster": {
          "description": "Name of the instance the node belongs to; null when unknown. Missing only from older tool versions.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture": {
          "description": "Id of the capture the set was collected in (an export job id or a hash of the member set ids); sets with the same capture are viewed together. Missing only from older tool versions.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingest": {
          "description": "Only from ingest (CLI and job result).",
          "$ref": "#/$defs/IngestInfo"
        },
        "merges": {
          "description": "Drain3 merge proposals (ingest --mine).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeRow"
          }
        },
        "summary": {
          "description": "Only from set and GET /api/sets/{ref}.",
          "$ref": "#/$defs/SetSummary"
        }
      },
      "required": [
        "schema",
        "id",
        "name",
        "format",
        "sources",
        "first_ts",
        "last_ts",
        "entry_count",
        "group_count",
        "created_at",
        "tool_version",
        "schema_version",
        "signature_version",
        "mask_rules_version",
        "signature_spec"
      ]
    }
  }
}
